# 统一行尾为 LF，避免在 Windows 上 checkout 出 CRLF 再提交回来造成整文件 diff。
* text=auto eol=lf

# 文本文件显式声明（便于 git 正确做 diff / merge）
*.ts    text eol=lf
*.js    text eol=lf
*.mjs   text eol=lf
*.json  text eol=lf
*.md    text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf
*.py    text eol=lf
*.sh    text eol=lf
*.txt   text eol=lf
*.cff   text eol=lf

# 二进制：不要做任何行尾或编码转换
*.png   binary
*.jpg   binary
*.jpeg  binary
*.svs   binary
*.tiff  binary
*.npz   binary

# 由 npm 生成，diff 噪声大，语言统计里也不算「源码」
package-lock.json linguist-generated=true
