# ===== 决策/编排 LLM 端点（2026-09-11）=====
# **默认不设 = 仍打 SiliconFlow**（`https://api.siliconflow.cn/v1` + `Qwen/Qwen3-8B`），行为与本地化前逐字节一致。
#
# 为什么要能切：硅基免费档实测同一条请求（同 prompt、输出 621 vs 585 tok）跑出
# **158.4s vs 21.3s（7.4×）**，吞吐在 3.9–27.4 tok/s 之间抽签；per-call `min 13.1s / p50 54.3s / max 240.1s`，
# 而 240.1s 正是 PATHASK_LLM_TIMEOUT_MS 到点——**超时后回落规则投票，烧 240s 换零诊断价值**。
# 这在 A/B 里会污染对照（两臂抽到不同超时率＝差异里混进回退率）。
#
# 自建 vLLM 端点实测 26.7 tok/s、抖动 1.00×，
# 最大真实证据包整包 18.1s。启用：PATHASK_LLM_BASE_URL=http://127.0.0.1:8014/v1
#
# ⚠️ 用 PATHASK_ 前缀不只是命名习惯：评测脚本的 env 快照 grep `^(VLLM_|PATHASK_)`，
#    SILICONFLOW_* **不进快照**——端点走 PATHASK_LLM_BASE_URL 才能自动进快照，
#    让日后任何一次全量都能回答「这轮打的是哪台」。
#
# 切换端点时**自动**跟着变的三件事（判定都在 src/util/llmEndpoint.ts，两条调用点共用）：
#  ① 代理：内网/回环地址**不挂 ProxyAgent**——undici 的 ProxyAgent 不读 NO_PROXY，
#     否则 内网端点 会被经 SILICONFLOW_PROXY 转发而连不通（本地化最易翻车的一环）
#  ② 思考字段：硅基认**顶层** `enable_thinking`；vLLM 顶层是**空操作**，必须发
#     `chat_template_kwargs:{enable_thinking}`（实测顶层 ≡ 什么都不传：1079tok/40.4s vs 478tok/18.1s）
#  ③ 超时默认值：硅基 240s（抽签端点的必要余量）→ 本地 120s
# PATHASK_LLM_BASE_URL=http://127.0.0.1:8014/v1
# PATHASK_LLM_MODEL=qwen3-8b                 # 默认 Qwen/Qwen3-8B（硅基的 model id）
# PATHASK_LLM_API_KEY=                       # 优先级高于 SILICONFLOW_API_KEY；内网端点缺 key 自动用占位 'EMPTY'
# PATHASK_LLM_PROXY=                         # 优先级高于 SILICONFLOW_PROXY；内网端点不生效（见①）
# PATHASK_LLM_CONTEXT_WINDOW=131072          # 与 serve 脚本的 --max-model-len 对齐

# ===== SiliconFlow（Qwen3-8B 决策者；未设 PATHASK_LLM_BASE_URL 时的默认端点）=====
SILICONFLOW_API_KEY=
SILICONFLOW_PROXY=
# 决策 LLM 单次 HTTP 超时（默认随端点：硅基 240000 / 本地 120000；analyze_evidence 的 ctx.signal 与之取 any）
# PATHASK_LLM_TIMEOUT_MS=240000

# ===== 工具韧性（2026-09-10）=====
# 单次工具调用墙钟预算的**全局默认**（各工具 metadata.timeoutMs 优先；默认 300000）
# 超时是「抓死锁」不是「压性能」——合法慢路径真实存在（4.95GP 巨片冷重算 mask ≈205s、CONCH 冷加载 ≈25s）
# PATHASK_TOOL_TIMEOUT_MS=300000
# 单个病例（一次 runQuestion）的墙钟截止：到点 agent.abort()，已产生的部分观测保留并标 partial（默认 900000）
# PATHASK_CASE_TIMEOUT_MS=900000
# describe_patch / patchCache 扇出并发上限（对齐 vLLM 排队容量，默认 4；调高会撞 lever3 并发超时）
# PATHASK_FANOUT_CONCURRENCY=4

# ===== 端点熔断 + 瞬时故障重试预算（2026-09-11）=====
# 之前「有界但不自适应」：每个工具各自付一次固定墙钟，没有跨调用的健康状态
# → 桥挂死时 101 例各付 300s。熔断只做一件事：别再付第二次。
# 三条刻意取舍（改前务必读 src/util/resilience.ts 顶部注释）：
#  ① 只动失败路径，成功路径一字不改（评测靠锁 env 快照，浮动预算会抽掉「同配置可复现」的地板）
#  ② 连接类失败 = 服务死亡的**无歧义**证据 → 直接记服务级；超时是**模糊**证据 → 先归 (端点,slide)，
#     窗口内够多张**不同**片子都超时才升级为服务级（否则一张 4.95GP 病态巨片能判死整个服务）
#  ③ 只有瞬时类计数——HTTP 4xx / 坏 patch_ref / EISDIR 这类业务失败**不进熔断**（那是数据问题不是健康信号）
# PATHASK_BREAKER_THRESHOLD=3           # 连续 N 次瞬时失败 → 熔断（默认 3）
# PATHASK_BREAKER_COOLDOWN_MS=30000     # 首次冷却（默认 30s）；half-open 探测失败后**翻倍**（退避在这里，不在工具层 sleep）
# PATHASK_BREAKER_MAX_COOLDOWN_MS=300000 # 冷却翻倍上限（默认 5min）
# PATHASK_BREAKER_SLIDE_ESCALATION=3    # 窗口内多少张**不同**片子超时 → 升级为服务级（默认 3）
# PATHASK_BREAKER_WINDOW_MS=120000      # 跨片升级的滚动窗口（默认 2min）
# 瞬时故障重试**预算**（默认 3；病例级，新会话重置）。只改「跟模型说什么」——不改任何调用行为、不自动重试：
# 用尽后错误文本转终态（⛔ 明确劝退、要求换证据路径）。语义类错误（PATCH_NOT_FOUND 等）**不设上界**，
# 因为结构化错误里附了可用备选列表，照着改 id 重试是唯一的自愈通道。0 = 完全关掉。
# PATHASK_TRANSIENT_RETRY_BUDGET=3

# ===== Agent 循环治理（B0–B6，2026-09-11）=====
# 防御性治理：基线 101 例的循环面很小（重复调用 6.2%、无病例撞步数上限、verify_region 仅占墙钟约 4.7%），
# 补全的价值在于**堵住可能发生的失控**与**让循环可度量**，不要期待分数提升。
# 三条总原则：① 观测类默认开且零行为改动；② 干预类一律 env 门控；③ **不引入任何自动重试**——
# 所有干预只改「模型看到什么」（错误文本 / 步数限额 / 每轮状态行），决定权仍在模型与既有兜底。
#
# 总开关：0 = 精确复现 B3 之前的今日行为（A/B 的对照臂）
# PATHASK_LOOP_GUARD_ENFORCE=1
# 工具调用数硬上限（默认 15）。**产品层**的步数护栏：到顶后在 beforeToolCall 里拦下非收尾类工具并 terminate，
# 由模型优雅收尾（不是 abort 硬中断）。回落兼容旧评测常量 MAX_TOOLS（见文件末尾）。
# PATHASK_MAX_TOOLS=15
# 优雅收尾的宽限步数（默认 2）：shouldStopAfterTurn 的保险，防「整批都是收尾类工具」时僵在原地
# PATHASK_MAX_TOOLS_GRACE=2
# 无进展检测：连续 K 步零新增证据（默认 4；基线均 6.89 步、p50 6 步）→ 记 stall 并投递一次性提示
# PATHASK_NOPROGRESS_K=4
# 起步保护：至少跑够这么多步才允许判 stall（默认 3，防开局 setup 误判）
# PATHASK_STALL_MIN_STEPS=3
# 振荡检测（A→B→A→B）。**不是无进展的特例**：振荡的两次调用各自都可能带来新证据，delta 恒 >0
# PATHASK_OSCILLATION_CYCLES=3
# PATHASK_OSCILLATION_PERIOD=2
# 成本预算。硬阈拦**探索类**工具、放行收尾类（analyze/counterfactual/generate_report）。
# 默认 250k ≈ 加权实测 max(193,930) 的 1.29×——对今天的正常病例永不触发，只抓真正的失控。
# PATHASK_TOKEN_BUDGET=250000
# PATHASK_VLM_CALL_BUDGET=40
# 软阈比例（默认 0.8）：**两个维度任一越线**都注入状态行——token 加权 ≥0.8×250k=200k，
# 或 VLM 调用数 ≥0.8×40=32。⚠️ 别把它当成"token 预算的 80%"：按基线实测量级，
# **真正会开火的是 VLM 那一维**——VLM p99=32 / max=34 正好压在 32 这条线上（≈ top 1% 的病例），
# 而 token 加权 max(193,930) 只到 200k 阈值的 97%，**一次都没触发过**。
# 2026-09-11 实测印证：lg=1 臂 10 例里唯一的注入例是 vlm=34，同例 token 仅 63%。
# PATHASK_BUDGET_SOFT_RATIO=0.8
# scan_overview 缓存读路径（默认 **1=开**）。命中且文本非空则直返，仍 addEvidence（节点数与今日一致）。
# PATHASK_SCAN_CACHE_READ=1
# describeCache 的 key 是否并入 question（默认 **0=关**）。默认关的理由：开了会把「缓存命中」变成
# 「更多 VLM 调用」，成本上升。关闭时命中不同问题的缓存会在文本里**明说**（questionMismatch）。
# PATHASK_DESCRIBE_CACHE_BY_QUESTION=0
# 分析新鲜度重跑（默认 **0=关**）。开了之后「analyze 之后又采到可投票新证据」会清旧分析节点并重跑 analyze_evidence。
# ⚠️ 本轮风险最高的一项（改报告置信度与证据图，重跑可能翻转主诊断）→ 先 A/B 再谈默认值。
# PATHASK_FRESH_ANALYSIS=0
# 【预算收尾】prompt 段（默认 **1=开**）。解开「证据裁决禁止以证据不足收尾」与「收尾强制必须走
# generate_report」之间的死结——出口开在**投票引擎内部**（报告可带 insufficient_evidence + request_human）。
# PATHASK_PROMPT_BUDGET_CLAUSE=1
# 语义重复提示（默认 **0=关**，建议 3）。同 (tool, code) 失败达阈值时把「可否重试」换成终态措辞。
# 只改文案：不消费令牌、不改可用工具集。瞬时类 code 不适用（那条由 PATHASK_TRANSIENT_RETRY_BUDGET 管）。
# PATHASK_SEMANTIC_REPEAT_HINT=0

# ===== Patho-R1 VLM（describe_patch / verify_region）=====
VLLM_BASE_URL=http://127.0.0.1:8012/v1
VLLM_MODEL=patho-r1-7b
VLM_TIMEOUT_MS=60000

# ===== WSI 桥接 =====
PATHASK_BRIDGE_URL=http://127.0.0.1:8787
PATHASK_WSI_REGISTRY=
# 桥接**单次 HTTP** 的墙钟上限（默认 300000）。无 signal 的调用也生效（此前裸 fetch 只能靠 undici 默认值，
# 且超时分类不出来）。比工具预算(300~420s)略小是刻意的：桥端先到点 → 错误落 BRIDGE_TIMEOUT 而非笼统 TOOL_TIMEOUT。
# 实测最慢合法路径 = 4.95GP 巨片冷重算掩膜 ≈205s，5min 是 1.5×
# PATHASK_BRIDGE_TIMEOUT_MS=300000

# ===== 模型权重根目录（wsi-bridge 运行时）=====
PATHASK_STREAM_ROOT=
CONCH_WEIGHTS=
PLIP_PATH=

# ===== 部署脚本 =====
PATHO_R1_MODEL=
PATHASK_PYTHON=

# ===== 采样 / 导航 / 证据保真（长期旋钮，默认值即生产档）=====
# 采样打分模式（默认 blend：0.6×核密度 + 0.4×组织密度）。tissue=旧的裸组织密度（回退用）| nuclear=纯核密度。
# 为什么改默认：tissue_fraction 把纤维/平滑肌/空白都算「组织」，核密的癌灶反而排名低 → 采样系统性偏向良性结缔组织。
# PATHASK_ROI_SCORE=blend
# blend 里 nuclear 的权重（0-1，默认 0.6；仅扫参用）
# PATHASK_ROI_BLEND_W=0.6
# 候选 ROI 的基线个数 k（默认 5，密度 top-k）。perceive/canary 可调大以扩大票面覆盖。
# PATHASK_ROI_BASELINE_K=5
# detect_roi 的排序模式（默认 density）。conch = 切回 CONCH/PLIP 语义检索（消融用；泛词查询会把 agent 领到背景弱区）。
# PATHASK_ROI_MODE=density
# 导航器增量采样的目标覆盖数（默认 = 基线 k）。cov <= k 时不做增量。
# PATHASK_NAV_COVERAGE=5
# perceive 单次最多描述多少个 patch（默认 24）
# PATHASK_PERCEIVE_MAX_PATCHES=24
# describe_patch 批量扇出的 VLM 并发（默认 4；对齐 vLLM 排队容量，调高会撞并发超时）
# PATHASK_VLM_CONCURRENCY=4
# describe_patch 入库的 claim 是否保原文（默认 1=全文）。=0 回退到旧的 slice(0,300)——那会砍掉后半段的恶性转折
# PATHASK_CLAIM_FULL=1
# retrieve_similar_case 的相似度地板（默认 0.4；低于它不返回，防「硬凑一个相似病例」）
# PATHASK_SIM_FLOOR=0.4
# 收尾兜底前至少要有几条 describe 证据（默认 1）
# PATHASK_MIN_DESCRIBE=1
# 上下文压缩（**⚠️ 已被全量证伪，默认关且不建议打开**：全量 101 上弃诊 4.9%→45.9%、方向 59%→23%。
# 机制：折叠历史 → agent 提前收手 → 决策空虚 → 弃诊。源码保留，仅供将来以证据库感知的形态重启。）
# PATHASK_CTX_COMPACT=0
# PATHASK_CTX_KEEP_TOKENS=12000
# PATHASK_CTX_KEEP_TURNS=8

# ===== 评估 / 调试 =====
# ⚠️ 旧评测侧的步数常量。B4 起同一个上限住在**产品层**（`PATHASK_MAX_TOOLS`，`resolveMaxTools()`），
# 这里只为让**既有 env 快照**继续生效而保留回落兼容——新写的脚本请用 PATHASK_MAX_TOOLS。
MAX_TOOLS=15
PATHASK_DEBUG=0
QWEN_THINKING=0
# 生产档组合（全量 A/B 必须锁这三项，见你的评测脚本）：
# PATHASK_DECISION=llm        # llm | rule
# PATHASK_MORPH_PROMPT=pure   # pure（无 5-label）| label5
# PATHASK_LABEL_WIRE=off      # 关标签接线（防 VLM 被 label 诱导）
# PATHASK_EXEC_TEMP=0.3
# PATHASK_AMBIG_CONF=0.6      # 「待进一步评估」判 ambiguous_morphology 的置信门
